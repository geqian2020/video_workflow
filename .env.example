# Copy to .env. The server binds to localhost and stores projects in ./data.
VIDEO_WORKFLOW_DATA=./data
# sapi: Windows offline Chinese speech; edge: online Chinese speech.
VIDEO_WORKFLOW_TTS=sapi
VIDEO_WORKFLOW_EDGE_VOICE=zh-CN-XiaoxiaoNeural
# Set this on systems without a default Chinese font.
# VIDEO_WORKFLOW_FONT=/path/to/NotoSansCJK-Regular.ttc
# Optional phase 2: your own Presenton server, with a model configured there.
# PRESENTON_URL=http://127.0.0.1:5001
# PRESENTON_API_KEY=
# Optional narrated-script generation, OpenAI-compatible endpoint.
# WORKFLOW_LLM_URL=http://127.0.0.1:11434/v1
# WORKFLOW_LLM_MODEL=
# WORKFLOW_LLM_API_KEY=
